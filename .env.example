export OTEL_SERVICE_NAME="cynditaylor-com-bot"
export OTEL_TRACES_EXPORTER="otlp"
export OTEL_LOGS_EXPORTER="otlp"
export OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"
export OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="http://localhost:4318/v1/traces"
export OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true

# Local collector forwards traces to the Honeycomb "local" environment.
# Cloud uses a separate ingest key inside collector/.env — leave that alone.
export HONEYCOMB_API_KEY=""
export HONEYCOMB_OTLP_ENDPOINT="https://api.honeycomb.io"

export GITHUB_TOKEN=""
# ARN of the Secrets Manager entry holding GITHUB_TOKEN. Used by the AgentCore
# runtime to fetch the token at startup; safe to commit (it's just an ARN).
export GITHUB_TOKEN_SECRET_ARN="arn:aws:secretsmanager:us-west-2:414852377253:secret:cyndibot/github-token-hdaGjb"
