#!/usr/bin/env bash
set -euo pipefail

# Local OTel collector — runs the same collector/config.yaml that Boswell
# uses in cloud, mounted into an otel/opentelemetry-collector-contrib
# container. Forwards traces to the Honeycomb "local" environment.
#
# Why the same config as cloud? Identical trace shape in both environments
# (same OTTL lift, same `collector.boswell.*` provenance) means boards and
# queries built against one work against the other. The three diffs from
# Boswell's Lambda packaging are absorbed at runtime:
#   - Bearer auth: enforced here too, with a static localhost-only token.
#   - X-Amzn-Trace-Id `from_context`: header not sent locally, attr lands
#     empty. Harmless.
#   - sending_queue disabled: was a Lambda freeze workaround, also fine
#     at low local traffic.

REPO_DIR="$(cd "$(dirname "$0")" && pwd)"
ENV_FILE="${REPO_DIR}/.env"
CONFIG_FILE="${REPO_DIR}/collector/config.yaml"
CONTAINER="cynditaylor-collector"
IMAGE="otel/opentelemetry-collector-contrib:latest"

if [[ ! -f "${ENV_FILE}" ]]; then
  echo "FAIL: ${ENV_FILE} not found. Copy .env.example and fill in HONEYCOMB_API_KEY." >&2
  exit 1
fi

if docker ps --format '{{.Names}}' | grep -q "^${CONTAINER}$"; then
  echo "Collector already running -> http://localhost:4318"
  exit 0
fi

if docker ps -a --format '{{.Names}}' | grep -q "^${CONTAINER}$"; then
  echo "Removing stale stopped container..."
  docker rm "${CONTAINER}" >/dev/null
fi

# Stamp spans with this commit so we can tell, in Honeycomb, which build of
# the config processed a span — same convention Boswell uses in cloud
# (collector/scripts/build derives it via `git rev-parse --short HEAD`).
BOSWELL_VERSION="$(git -C "${REPO_DIR}" rev-parse --short HEAD 2>/dev/null || echo dev)"
if [[ -n "$(git -C "${REPO_DIR}" status --porcelain 2>/dev/null)" ]]; then
  BOSWELL_VERSION="${BOSWELL_VERSION}-dirty"
fi

echo "Starting otel-collector-contrib (BOSWELL_VERSION=${BOSWELL_VERSION})..."
docker run -d \
  --name "${CONTAINER}" \
  --env-file "${ENV_FILE}" \
  -e "BOSWELL_VERSION=${BOSWELL_VERSION}" \
  -p 4318:4318 \
  -v "${CONFIG_FILE}:/etc/otelcol-contrib/config.yaml:ro" \
  "${IMAGE}" \
  --config=/etc/otelcol-contrib/config.yaml >/dev/null

echo "OTLP HTTP -> http://localhost:4318/v1/traces"
echo "Logs      -> docker logs -f ${CONTAINER}"
